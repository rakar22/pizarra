# Public football data endpoints used by the V1 browser client.
# Keep private API keys out of the repository. Production secrets belong
# in the deployment environment and should be accessed server-side.
VITE_ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/soccer
VITE_ESPN_LEAGUES=esp.1,eng.1,ita.1,ger.1,fra.1
